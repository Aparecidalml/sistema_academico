<%- include('partials/header', { titulo: 'Dashboard' }) %>

<main class="dashboard-main">

    <!-- Boas-vindas -->
    <section class="welcome-section">

        <h2>Olá, <%= usuario.nome %>!</h2>

        <p>
            Seja bem-vindo ao Sistema Acadêmico.
            Utilize os módulos abaixo para gerenciar os dados da instituição.
        </p>

    </section>

    <!-- Gerenciamento -->
    <section class="dashboard-container">

        <h3>Menu de Gerenciamento</h3>

        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Módulo</th>
                    <th>Visualização</th>
                    <th>Cadastro</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td><strong>Cursos</strong></td>
                    <td><a href="/cursos">Visualizar Cursos</a></td>
                    <td><a href="/cadastro-curso">Cadastrar Novo Curso</a></td>
                </tr>

                <tr>
                    <td><strong>Disciplinas</strong></td>
                    <td><a href="/disciplinas">Visualizar Disciplinas</a></td>
                    <td><a href="/cadastro-disciplina">Cadastrar Nova Disciplina</a></td>
                </tr>

                <tr>
                    <td><strong>Alunos</strong></td>
                    <td><a href="/alunos">Visualizar Alunos</a></td>
                    <td><a href="/cadastro-aluno">Cadastrar Novo Aluno</a></td>
                </tr>
            </tbody>
        </table>

    </section>

</main>

<%- include('partials/footer') %>