<%- include('../partials/header', { titulo: 'Alunos' }) %>

<main class="page-container">

    <div class="page-header">

        <div>
            <h2>Alunos Cadastrados</h2>
            <br><br>
        </div>    

    </div>

    <div class="content-card">

        <table class="dashboard-table">

           <thead>
    <tr>
        <th>Matrícula</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Telefone</th>
        <th>Ações</th>
    </tr>
</thead>

<tbody>

<% alunos.forEach(aluno => { %>

<tr>

    <td><%= aluno.matricula %></td>
    <td><%= aluno.nome %></td>
    <td><%= aluno.email %></td>
    <td><%= aluno.tel %></td>

    <td class="acoes">

        <button
            class="btn-editar"
            onclick="abrirModal(
                '<%= aluno.idAluno %>',
                '<%= aluno.nome %>',
                '<%= aluno.email %>',
                '<%= aluno.tel %>'
            )"
        >
            ✏️ Editar
        </button>

        <form
            action="/aluno/<%= aluno.idAluno %>?_method=DELETE"
            method="POST"
            style="display:inline;"
            onsubmit="return confirm('Deseja realmente excluir este aluno?')"
        >
            <button
                type="submit"
                class="btn-excluir"
            >
                🗑 Excluir
            </button>
        </form>

    </td>

</tr>

<% }) %>

</tbody>

        </table>

    </div>

    <div id="modalEditar" class="modal">

    <div class="modal-content">

        <div class="modal-header">

            <h3>Editar Aluno</h3>

            <span
                class="fechar"
                onclick="fecharModal()"
            >
                &times;
            </span>

        </div>

        <form
            id="formEditar"
            method="POST"
        >

            <div class="form-group">

                <label>Nome</label>

                <input
                    type="text"
                    id="editNome"
                    name="nome"
                    required
                >

            </div>

            <div class="form-group">

                <label>Email</label>

                <input
                    type="email"
                    id="editEmail"
                    name="email"
                    required
                >

            </div>

            <div class="form-group">

                <label>Telefone</label>

                <input
                    type="text"
                    id="editTel"
                    name="tel"
                    required
                >

            </div>

            <button
                type="submit"
                class="btn-primary"
            >
                Salvar Alterações
            </button>

        </form>

    </div>

</div>

</main>

<script src="../js/aluno.js"></script>

<%- include('../partials/footer') %>