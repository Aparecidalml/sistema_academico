<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alunos</title>
</head>
<body>
    <div style="display: flex; gap: 10px;">
        <a href="/dashboard">
            <button type="button"> VOLTAR AO PAINEL </button>
        </a>
    </div>
    <h1>Alunos Cadastrados</h1>
    <h3>
    <% alunos.forEach(aluno => { %>
        <div>
            Aluno: <%= aluno.nome %>
            <ul>
                <li>Matrícula: <%= aluno.matricula %></li>              
                <li>E-mail: <%= aluno.email %></li>
                <li>Telefone: <%= aluno.tel %></li>
            </ul>
        </div>
    <% }) %>
    </h3>
    <br><br><br><br>
  <footer>
        <form action="/logout" method="post">
            <button type="submit" style="background-color: #ff4d4d; color: white; padding: 8px 15px; border: none; cursor: pointer;">
                SAIR DO SISTEMA
            </button>
        </form>
    </footer>
</body>
</html>