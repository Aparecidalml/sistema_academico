<%- include('../partials/header', { titulo: 'Cadastrar Disciplina' }) %>

    <main class="cadastro-main">

        <div class="cadastro-card">

            <h2>Cadastrar Disciplina</h2>
            <p>Preencha os dados da nova disciplina.</p>

            <form action="/disciplina" method="POST" class="cadastro-form">

                <div class="form-group">
                    <label>Código</label>
                    <input type="text" name="cod_disciplina" placeholder="Ex: DIS001" required>
                </div>

                <div class="form-group">
                    <label>Nome</label>
                    <input type="text" name="disciplina" placeholder="Nome da disciplina" required>
                </div>

                <div class="form-group">
                    <label>Carga Horária</label>
                    <input type="number" name="ch_disciplina" placeholder="Ex: 60" required>
                </div>

                <div class="form-group">
                    <label>Professor</label>
                    <input type="text" name="prof" placeholder="Nome do professor" required>
                </div>

                <div class="form-group">
                    <label>Curso</label>
                    <input type="text" name="curso" placeholder="Ex: ADS" required>
                </div>

                <button type="submit" class="btn-primary">Salvar </button>
            </form>
        </div>

    </main>

    <%- include('../partials/footer') %>
