<%- include('../partials/header', { titulo: 'Usuários' }) %>

    <main class="page-container">
        <div class="page-header">
            <div>
                <h2>Usuários Cadastrados</h2>
                <br><br>
        
            </div>
        </div>

        <div class="content-card">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Perfil</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    <% usuarios.forEach(usuario=> { %>
                        <tr>
                            <td><%= usuario.nome %></td>
                            <td><%= usuario.email %></td>
                            <td><%= usuario.perfil %></td>
                            <td class="acoes">
                                <button class="btn-editar" onclick="abrirModal(
                                '<%= usuario.idUser %>','<%= usuario.nome %>','<%= usuario.email %>','<%= usuario.perfil %>'
                                )"> ✏️ Editar </button>

                                <form action="/usuario/<%= usuario.idUser %>?_method=DELETE" method="POST" style="display:inline;"
                                    onsubmit="return confirm('Deseja realmente excluir este usuário?')">
                                    <button type="submit" class="btn-excluir"> 🗑 Excluir</button>
                                </form>

                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>

        <div id="modalEditar" class="modal">

            <div class="modal-content">
                <div class="modal-header">
                    <h3>Editar Usuário</h3>
                    <span class="fechar" onclick="fecharModal()">
                        &times;
                    </span>

                </div>

                <form id="formEditar" method="POST">
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" id="editNome" name="nome" required>                  

                        <label>Email</label>
                        <input type="email" id="editEmail" name="email" required>

                        <label>Perfil</label>
                        <select name="perfil" id="editPerfil" required>
                            <option value="">Selecione</option>
                            <option value="Estudante">Estudante</option>
                            <option value="Professor">Professor</option>
                            <option value="Coordenador">Coordenador</option>
                            <option value="Administrador">Administrador</option>
                        </select>

                    </div>

                    <button type="submit" class="btn-primary"> Salvar Alterações </button>
                    <button type="button" class="btn-secondary" onclick="fecharModal()"> Cancelar </button>
                </form>
            </div>
        </div>

    </main>

    <script src="../js/usuario.js"></script>

    <%- include('../partials/footer') %>