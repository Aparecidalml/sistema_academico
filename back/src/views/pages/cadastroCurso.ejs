<%- include('../partials/header', { titulo: 'Cadastrar Curso' }) %>

    <main class="cadastro-main">

        <div class="cadastro-card">

            <h2>Cadastrar Curso</h2>
            <p>Preencha os dados do novo curso.</p>

            <form action="/curso" method="POST" class="cadastro-form">

                <div class="form-group">
                    <label>Código</label>
                    <input type="text" name="cod" placeholder="Ex: ADS001" required>
                </div>

                <div class="form-group">
                    <label>Nome do Curso</label>
                    <input type="text" name="curso" placeholder="Ex: Análise e Desenvolvimento de Sistemas" required>
                </div>

                <div class="form-group">
                    <label>Carga Horária</label>
                    <input type="number" name="ch" placeholder="Ex: 2400" required>
                </div>

                <div class="form-group">
                    <label>Tipo</label>

                    <select name="tipo" required>
                        <option value="">Selecione</option>
                        <option value="Técnico">Técnico</option>
                        <option value="Graduação">Graduação</option>
                        <option value="Pós-graduação">Pós-graduação</option>
                        <option value="Extensão">Extensão</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary">Salvar </button>
            </form>
        </div>

    </main>

    <%- include('../partials/footer') %>
